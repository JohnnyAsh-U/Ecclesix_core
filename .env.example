# Ecclesix Core API Environment Variables

# Database
DATABASE_URL=sqlite:///./test.db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT/Auth
ACCESS_SECRET_KEY=your-access-secret-key-change-in-production
REFRESH_SECRET_KEY=your-refresh-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS & Hosts
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Application
APP_NAME=Ecclesix Core API
APP_VERSION=1.0.0
PROD=false
LOG_LEVEL=INFO

# Django Integration (Internal API)
DJANGO_BASE_URL=http://localhost:8000
INTERNAL_API_SECRET_ADMIN=admin-secret-key-change-in-production
INTERNAL_API_SECRET_MOD=mod-secret-key-change-in-production
DJANGO_REQUEST_TIMEOUT=10
DJANGO_RETRY_MAX_ATTEMPTS=3
DJANGO_RETRY_DELAY=1.0

#Prometheus
PROMETHEUS_URL=http://localhost:9090

# Object Storage (S3 Compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket-name


# Backup DB CREDENTIALS
BACKUP_DB_HOST=localhost
BACKUP_DB_PORT=5432
BACKUP_DB_USER=postgres
BACKUP_DB_PASSWORD=12345678
BACKUP_DB_NAME=chmsdb
