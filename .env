
# Database
DATABASE_URL = postgresql+asyncpg://postgres:12345678@localhost:5432/ecclesixcoredb

# Redis
REDIS_URL = redis://localhost:6379/0

# JWT/Auth
ACCESS_SECRET_KEY = your_secret_key_here
REFRESH_SECRET_KEY = your_refresh_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=10080


# CORS & Hosts
CORS_ORIGINS = http://localhost:5174,http://localhost:8000,http://192.168.1.9:8000,http://192.168.1.9:5173,http://localhost,http://192.168.1.10
ALLOWED_HOSTS = localhost,192.168.1.13,10.182.115.119,192.168.1.9


# Application
APP_NAME=Ecclesix Core API
APP_VERSION=1.0.0
PROD=false
LOG_LEVEL=INFO

# Django Integration (Internal API)
DJANGO_BASE_URL=http://localhost:8000
INTERNAL_API_SECRET_ADMIN=admin-secret-key
INTERNAL_API_SECRET_MOD=mod-secret-key
DJANGO_REQUEST_TIMEOUT=10
DJANGO_RETRY_MAX_ATTEMPTS=3
DJANGO_RETRY_DELAY=1.0
